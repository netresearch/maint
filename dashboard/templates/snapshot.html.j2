{% extends "base.html.j2" %}

{#
  An archived snapshot. Once written it is never regenerated, which is what makes
  it citable: the figures on this page will read the same next year.
#}

{% block content %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="{{ home }}">{{ t.hero.title }}</a> / <span aria-current="page">{{ snapshot_date }}</span>
</nav>

<section class="hero">
  <h1>{{ t.hero.title }} &middot; {{ snapshot_date }}</h1>
  <p class="notice">{{ t.snapshots.immutable_notice }} <a href="{{ home }}">{{ t.snapshots.current }}</a></p>
  <p class="meta">
    {{ t.snapshot.as_of }}: <time datetime="{{ snapshot.generated_at }}">{{ generated_display }}</time>
    &middot; {{ active_repos }} {{ t.snapshot.repos_active }}
  </p>
</section>

<section aria-labelledby="figures-heading">
  <h2 id="figures-heading">{{ t.snapshot.scope_lifetime }}</h2>
  <dl class="kpis">
    {%- for key, value in kpis.lifetime %}
    <div class="kpi">
      <dt class="kpi-label">{{ t.kpi[key] }}</dt>
      <dd class="kpi-value" data-figure="{{ key }}">{{ value | number(locale) }}</dd>
    </div>
    {%- endfor %}
  </dl>

  <h2>{{ t.snapshot.scope_recent }}</h2>
  <dl class="kpis">
    {%- for key, value in kpis.recent_30d %}
    <div class="kpi">
      <dt class="kpi-label">{{ t.kpi[key] }}</dt>
      <dd class="kpi-value" data-figure="{{ key }}">{{ value | number(locale) }}</dd>
    </div>
    {%- endfor %}
  </dl>
</section>

<section aria-labelledby="cite-heading">
  <h2 id="cite-heading">{{ t.cite.heading }}</h2>
  <blockquote id="citation-text" class="citation">{{ citation }}</blockquote>
  <p>
    <button type="button" class="btn" id="copy-citation" data-copied="{{ t.cite.copied }}">{{ t.cite.copy }}</button>
    <a class="btn" href="{{ base }}data/snapshots/{{ snapshot_date }}.json">{{ t.downloads.latest_json }}</a>
  </p>
</section>

<p><a href="{{ home }}">&larr; {{ t.repo.back }}</a></p>
{% endblock %}

{% block scripts %}
<script src="{{ base }}assets/dashboard.js"></script>
{% endblock %}
